# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs
*.log

# Environment. Create React App inlines REACT_APP_* variables into the bundle at build
# time, so anything here ships to the browser in plain sight.
.env
.env.*

# Keys and credentials
*.pem
*.key
credentials*
secrets/

# Local databases
*.sqlite
*.db

# Python, for the odd helper script
__pycache__/
